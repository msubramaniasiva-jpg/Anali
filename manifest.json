<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#080c14" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>Anali Technergies</title>
  <link rel="manifest" href="manifest.json" />
  <link rel="apple-touch-icon" href="icon-192.png" />
  <style>
    :root {
      --bg: #080c14;
      --panel: #0f172a;
      --panel-2: #111827;
      --line: rgba(148, 163, 184, 0.18);
      --text: #f8fafc;
      --muted: #94a3b8;
      --cyan: #38b6ff;
      --green: #10b981;
      --amber: #f59e0b;
      --red: #f87171;
      --shadow: rgba(0, 0, 0, 0.35);
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100%;
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      padding-bottom: 90px;
      -webkit-tap-highlight-color: transparent;
    }

    a { text-decoration: none; }
    button { font: inherit; }

    .app-shell {
      max-width: 560px;
      margin: 0 auto;
      min-height: 100vh;
      background: linear-gradient(180deg, #08111e 0%, #080c14 100%);
      position: relative;
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 20;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 16px;
      background: rgba(15, 23, 42, 0.9);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--line);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-mark {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid rgba(56, 182, 255, 0.4);
      background: rgba(56, 182, 255, 0.08);
    }

    .brand-mark img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .brand-text {
      line-height: 1.05;
    }

    .brand-title {
      font-size: 1rem;
      font-weight: 800;
      color: var(--cyan);
      letter-spacing: 0.08em;
    }

    .brand-sub {
      font-size: 0.62rem;
      letter-spacing: 0.18em;
      color: var(--text);
      opacity: 0.9;
      margin-top: 2px;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 6px 10px;
      border-radius: 999px;
      font-size: 0.68rem;
      font-weight: 700;
      border: 1px solid rgba(16, 185, 129, 0.35);
      background: rgba(16, 185, 129, 0.1);
      color: var(--green);
      white-space: nowrap;
    }

    .dot {
      width: 7px;
      height: 7px;
      background: var(--green);
      border-radius: 50%;
      display: inline-block;
      animation: blink 1.8s infinite ease-in-out;
    }

    @keyframes blink {
      0%, 100% { opacity: 0.3; transform: scale(0.95); }
      50% { opacity: 1; transform: scale(1); }
    }

    .screen {
      display: none;
      padding: 16px;
      animation: fadeUp 0.25s ease;
    }

    .screen.active {
      display: block;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .hero {
      background: linear-gradient(135deg, rgba(30, 41, 59, 0.95), rgba(15, 23, 42, 0.9));
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 14px 16px;
      margin-bottom: 16px;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    .metric-label {
      font-size: 0.62rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      font-weight: 700;
    }

    .metric-value {
      margin-top: 6px;
      font-size: 0.84rem;
      font-weight: 800;
      color: var(--amber);
      line-height: 1.3;
    }

    .metric-value.cyan { color: var(--cyan); }
    .metric-value.green { color: var(--green); }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin-bottom: 16px;
    }

    .card {
      background: rgba(15, 23, 42, 0.98);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 14px;
      box-shadow: 0 8px 20px var(--shadow);
    }

    .card .label {
      color: var(--muted);
      font-size: 0.66rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .card .value {
      margin-top: 8px;
      font-weight: 800;
      font-size: 1.2rem;
      color: var(--cyan);
      line-height: 1.2;
    }

    .card .meta {
      margin-top: 5px;
      color: var(--muted);
      font-size: 0.64rem;
    }

    .progress-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      background: rgba(15, 23, 42, 0.98);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 16px;
      margin-bottom: 16px;
    }

    .progress-title {
      font-size: 0.96rem;
      font-weight: 800;
    }

    .progress-sub {
      margin-top: 4px;
      font-size: 0.72rem;
      color: var(--muted);
    }

    .progress-link {
      display: inline-block;
      margin-top: 8px;
      color: var(--cyan);
      font-size: 0.72rem;
      font-weight: 700;
    }

    .progress-score {
      font-size: 1.5rem;
      font-weight: 900;
      color: var(--cyan);
    }

    .quick-actions {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
      margin-bottom: 18px;
    }

    .action-btn {
      border: 1px solid var(--line);
      background: rgba(15, 23, 42, 0.98);
      border-radius: 12px;
      color: var(--text);
      min-height: 78px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-size: 0.72rem;
      font-weight: 700;
      cursor: pointer;
    }

    .action-btn:active {
      transform: scale(0.98);
      background: rgba(30, 41, 59, 0.9);
    }

    .section-heading {
      font-size: 0.9rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 12px;
    }

    .list-card {
      background: rgba(15, 23, 42, 0.98);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 12px;
      margin-bottom: 12px;
    }

    .list-card .row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 6px;
    }

    .list-card .title {
      font-weight: 800;
      font-size: 0.9rem;
      color: var(--text);
    }

    .badge {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      padding: 4px 8px;
      font-size: 0.62rem;
      font-weight: 800;
      letter-spacing: 0.02em;
      border: 1px solid transparent;
    }

    .badge.cyan { background: rgba(56, 182, 255, 0.12); color: var(--cyan); border-color: rgba(56, 182, 255, 0.2); }
    .badge.green { background: rgba(16, 185, 129, 0.12); color: var(--green); border-color: rgba(16, 185, 129, 0.2); }
    .badge.amber { background: rgba(245, 158, 11, 0.12); color: var(--amber); border-color: rgba(245, 158, 11, 0.2); }

    .list-card .desc {
      color: var(--muted);
      font-size: 0.7rem;
      line-height: 1.55;
    }

    .task-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .task-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 12px;
      border-radius: 12px;
      background: rgba(15, 23, 42, 0.96);
      border: 1px solid var(--line);
      cursor: pointer;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }

    .task-item:active { transform: scale(0.995); }

    .task-item.done {
      border-color: rgba(16, 185, 129, 0.3);
      background: rgba(16, 185, 129, 0.04);
    }

    .task-item input[type="checkbox"] {
      width: 20px;
      height: 20px;
      accent-color: var(--cyan);
      flex-shrink: 0;
    }

    .task-main {
      flex: 1;
      min-width: 0;
    }

    .task-text {
      font-size: 0.8rem;
      font-weight: 700;
      line-height: 1.4;
      word-break: break-word;
    }

    .task-meta {
      margin-top: 4px;
      color: var(--muted);
      font-size: 0.66rem;
    }

    .task-item.done .task-text {
      text-decoration: line-through;
      color: var(--muted);
    }

    .project-list,
    .lead-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .cta-row {
      display: flex;
      gap: 8px;
      margin-top: 12px;
      flex-wrap: wrap;
    }

    .cta-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      padding: 8px 12px;
      font-size: 0.72rem;
      font-weight: 800;
      border: 1px solid var(--line);
      min-width: 90px;
    }

    .cta-btn.primary {
      background: rgba(56, 182, 255, 0.12);
      border-color: rgba(56, 182, 255, 0.28);
      color: var(--cyan);
    }

    .cta-btn.success {
      background: rgba(16, 185, 129, 0.12);
      border-color: rgba(16, 185, 129, 0.28);
      color: var(--green);
    }

    .bottom-nav {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 30;
      background: rgba(15, 23, 42, 0.96);
      border-top: 1px solid var(--line);
      backdrop-filter: blur(10px);
    }

    .nav-inner {
      max-width: 560px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 6px;
      padding: 8px 6px calc(10px + env(safe-area-inset-bottom));
    }

    .nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      min-height: 58px;
      border: none;
      background: transparent;
      color: var(--muted);
      font-weight: 700;
      font-size: 0.62rem;
      cursor: pointer;
    }

    .nav-item svg {
      width: 20px;
      height: 20px;
      fill: currentColor;
    }

    .nav-item.active {
      color: var(--cyan);
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      border: 0;
    }

    @media (max-width: 380px) {
      .hero {
        grid-template-columns: 1fr 1fr;
      }
      .quick-actions {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
  </style>
</head>
<body>
