  <script>
    const STORAGE_KEY = 'anali-checklist-v1';

    const defaultTasks = [
      { id: 1, title: 'Emails, Inquiries & Priority Goals', time: '09:00 - 10:15 AM', owner: 'Admin', done: true },
      { id: 2, title: 'Pix4D / WebODM Orthomosaic Stitching', time: '10:15 - 11:45 AM', owner: 'Processing', done: true },
      { id: 3, title: 'QGIS ΔT Thermal Anomaly Classification', time: '11:45 - 01:15 PM', owner: 'Analytics', done: true },
      { id: 4, title: 'LinkedIn Outreach: 10 Solar O&M Heads', time: '02:15 - 03:00 PM', owner: 'Lead Generation', done: false },
      { id: 5, title: 'Send 5 Free 1 MW Pilot Proposals (PDF)', time: '03:00 - 03:45 PM', owner: 'Sales Outreach', done: true },
      { id: 6, title: 'Publish RGB vs Thermal Case Study on LinkedIn', time: '04:00 - 04:45 PM', owner: 'Marketing', done: false },
      { id: 7, title: 'Follow Up on Quotations & Update CRM', time: '05:15 - 06:00 PM', owner: 'Sales Follow-up', done: true },
      { id: 8, title: 'Put Batteries in Storage Mode (50-60%)', time: '06:00 - 06:30 PM', owner: 'Battery Health', done: true }
    ];

    function loadTasks() {
      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
        if (Array.isArray(saved) && saved.length) return saved;
      } catch (e) {
        console.warn('Unable to parse saved checklist state:', e);
      }
      localStorage.setItem(STORAGE_KEY, JSON.stringify(defaultTasks));
      return defaultTasks;
    }

    function saveTasks(tasks) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(tasks));
    }

    function renderTasks() {
      const list = document.getElementById('taskList');
      const tasks = loadTasks();
      list.innerHTML = tasks.map(task => `
        <label class="task-item ${task.done ? 'done' : ''}">
          <input type="checkbox" ${task.done ? 'checked' : ''} data-id="${task.id}" aria-label="Mark ${task.title} as complete" />
          <div class="task-main">
            <div class="task-text">${task.title}</div>
            <div class="task-meta">${task.time} | ${task.owner}</div>
          </div>
        </label>
      `).join('');

      const checkboxes = list.querySelectorAll('input[type="checkbox"]');
      checkboxes.forEach((box) => {
        box.addEventListener('change', (event) => {
          const tasks = loadTasks();
          const target = tasks.find(task => String(task.id) === String(event.target.dataset.id));
          if (!target) return;
          target.done = event.target.checked;
          saveTasks(tasks);
          renderTasks();
          updateProgress();
        });
      });

      updateProgress();
    }

    function updateProgress() {
      const tasks = loadTasks();
      const total = tasks.length;
      const done = tasks.filter(task => task.done).length;
      const pct = total ? Math.round((done / total) * 100) : 0;

      const progressNote = document.getElementById('progressNote');
      const progressScore = document.getElementById('progressScore');

      if (progressNote) progressNote.textContent = `${done} of ${total} Tasks Completed`;
      if (progressScore) progressScore.textContent = `${pct}%`;
    }

    function showScreen(screenId) {
      document.querySelectorAll('.screen').forEach(screen => {
        screen.classList.toggle('active', screen.id === screenId);
      });

      document.querySelectorAll('.nav-item').forEach(button => {
        button.classList.toggle('active', button.dataset.target === screenId);
      });
    }

    document.querySelectorAll('.nav-item').forEach(button => {
      button.addEventListener('click', () => showScreen(button.dataset.target));
    });

    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('./sw.js').catch((err) => console.log('SW registration failed:', err));
      });
    }

    renderTasks();
  </script>
</body>
</html>
